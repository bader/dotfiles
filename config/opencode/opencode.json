{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "lsp": true,
  "instructions": [
    "~/.config/opencode/instructions.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git remote -v": "allow",
      "git diff --check *": "allow",
      "command -v *": "allow",
      "uname *": "allow",
      "* --version": "allow",
      "opencode --help": "allow",
      "opencode debug *": "allow",
      "bash -n *": "allow",
      "python3 -m json.tool *": "allow",
      "jq empty *": "allow"
    }
  }
}
