[core]
	editor = nvim
	whitespace = trailing-space,space-before-tab
	autocrlf = Input
	excludesfile = ~/.gitignore
[color]
	ui = auto
	status = auto
	branch = auto
[apply]
	whitespace = fix
[alias]
	st = status
	sw = switch
	mt = mergetool
	ci = commit
	co = checkout
	br = branch
	last = log -1 HEAD
	ri = rebase --interactive --autosquash
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit
[user]
	name = Alexey Bader
# Allow local customizations in the ~/.work/gitconfig file
[include]
    path = ~/.work/gitconfig
[merge]
	tool = nvimdiff
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "nvimdiff"]
	layout = "LOCAL,BASE,REMOTE / MERGED"
